<UserControl x:Class="AppTrace.UI.Dialogs.UninstallConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <!-- Translucent Dim Backdrop -->
    <Grid Background="{StaticResource ModalOverlayBrush}">
        <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Style="{StaticResource GlassCard}" Background="#E61A2230" BorderBrush="{StaticResource AccentBrush}" Padding="28">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Background="#20EF4444" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Confirm Official Uninstallation" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="AppTrace will launch the publisher's registered uninstaller" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Application Info Box -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Application:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentUninstallApp.DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Publisher:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentUninstallApp.Publisher}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Uninstall Method:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentUninstallPlan.UninstallType}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Command:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentUninstallPlan.ExecutablePath}" 
                                       FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Safety Guidelines Callout -->
                <Border Background="#15F59E0B" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🛡️ Safe Removal Protocol:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="1. AppTrace never forcibly terminates running tasks or deletes shared libraries silently." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="2. The official vendor uninstaller wizard will be displayed for your interactive approval." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="3. After completion, AppTrace will offer to scan for leftover configuration directories." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding UninstallDialogCancelCommand}" Content="Cancel" Margin="0,0,10,0" Width="100" />
                    <Button Style="{StaticResource DangerButton}" Command="{Binding UninstallDialogApproveCommand}" Content="Start Uninstaller" Width="150" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
