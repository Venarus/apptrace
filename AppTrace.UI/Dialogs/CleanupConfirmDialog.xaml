<UserControl x:Class="AppTrace.UI.Dialogs.CleanupConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <!-- Translucent Dim Backdrop -->
    <Grid Background="{StaticResource ModalOverlayBrush}">
        <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Style="{StaticResource GlassCard}" Background="#E61A2230" BorderBrush="{StaticResource AccentBrush}" Padding="28">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Background="#2010B981" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="🧹" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Approve Remnant Cleanup" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Final review before removing selected residual items" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Statistics Box -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Selected Items" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding CleanupItemsCount, StringFormat='{}{0} files &amp; folders'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Space to Recover" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding CleanupTotalSize}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Safety Confirmation Notes -->
                <Border Background="#153B82F6" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🛡️ Non-Destructive Safe Removal Details:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="• Files are sent to the Windows Recycle Bin (instant undo supported)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• A safety snapshot is saved to the AppTrace Quarantine Vault." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• All operations are written to your local audit log." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding CleanupDialogCancelCommand}" Content="Cancel" Margin="0,0,10,0" Width="100" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanupDialogApproveCommand}" Content="Approve &amp; Clean" Width="160" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
