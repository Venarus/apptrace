<UserControl x:Class="AppTrace.UI.Views.ActivityHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ActivityHistoryViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Activity History &amp; Audit Log" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tamper-evident local SQLite audit trail for all software installations, scans, and cleanups" 
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}" Content="📥 Export CSV" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearActivitiesCommand}" Content="🗑️ Clear Logs" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshActivitiesCommand}" Content="↻ Refresh" />
            </StackPanel>
        </Grid>

        <!-- Search & Filter Controls -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="Search logs by app name or description..." />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="All Events" 
                                 Click="OnActionFilterClicked" Tag="All" Margin="0,0,4,0" IsChecked="True" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="Uninstalls" 
                                 Click="OnActionFilterClicked" Tag="Uninstall" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="Cleanups" 
                                 Click="OnActionFilterClicked" Tag="Cleanup" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="Scans" 
                                 Click="OnActionFilterClicked" Tag="Scan" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="Restores" 
                                 Click="OnActionFilterClicked" Tag="Restore" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="Errors" 
                                 Click="OnActionFilterClicked" Tag="Error" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding Activities.Count, StringFormat='{}{0} events recorded'}" 
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- History DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="4">
            <DataGrid Style="{StaticResource FluentDataGrid}" ItemsSource="{Binding Activities}">
                <DataGrid.Columns>
                    <!-- Timestamp -->
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding FormattedTimestamp}" Width="150" />

                    <!-- Action Type Badge -->
                    <DataGridTemplateColumn Header="Action" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#203B82F6" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActionType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Application -->
                    <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="180" FontWeight="SemiBold" />

                    <!-- Description -->
                    <DataGridTextColumn Header="Summary" Binding="{Binding Description}" Width="2*" />

                    <!-- Details -->
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />

                    <!-- Success Indicator -->
                    <DataGridTemplateColumn Header="Result" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding Success, Converter={StaticResource StartupStateToColor}}">
                                    <TextBlock Text="{Binding Success, Converter={StaticResource BoolToVis}, ConverterParameter='Success|Failed'}" 
                                               FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
