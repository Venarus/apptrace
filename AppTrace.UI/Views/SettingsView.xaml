<UserControl x:Class="AppTrace.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="850" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Settings &amp; Preferences" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Personalize Windows 11 visual appearance, adjust remnant detection heuristics, and manage safe exclusions" 
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,24" />

            <!-- Appearance Section -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Visual Aesthetics &amp; Fluent Design" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Theme Selection -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Application Theme" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Choose between dark mode or light mode appearance" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource FluentComboBox}" Width="160" 
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBoxItem Tag="Dark" Content="🌙 Koyu (Dark)" />
                            <ComboBoxItem Tag="Light" Content="☀️ Açık (Light)" />
                            <ComboBoxItem Tag="System" Content="💻 Sistem" />
                        </ComboBox>
                    </Grid>

                    <!-- Language Selection -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Application Language / Dil" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Uygulama arayüz dili (Türkçe / English)" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource FluentComboBox}" Width="160" 
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}">
                            <ComboBoxItem Content="🇹🇷 Türkçe" Tag="tr" />
                            <ComboBoxItem Content="🇬🇧 English" Tag="en" />
                        </ComboBox>
                    </Grid>

                    <!-- Windows 11 Backdrop Material -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Backdrop Material" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Native Windows 11 Desktop Window Manager (DWM) translucent blur surface" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource FluentComboBox}" Width="160" 
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding SelectedBackdrop, Mode=TwoWay}">
                            <ComboBoxItem Tag="Mica" Content="Mica (Windows 11)" />
                            <ComboBoxItem Tag="Acrylic" Content="Acrylic Bulanıklık" />
                            <ComboBoxItem Tag="None" Content="Düz Arka Plan" />
                        </ComboBox>
                    </Grid>

                    <!-- Window Opacity Slider -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Glass Transparency" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Adjust glassmorphism background opacity level" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="0.80" Maximum="1.00" Value="{Binding WindowOpacity, Mode=TwoWay}" 
                                SmallChange="0.02" LargeChange="0.05" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Accent Colors -->
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Accent Color" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Select your preferred brand accent color" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <!-- Blue -->
                            <Button Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                    Command="{Binding SelectAccentColorCommand}" CommandParameter="#3B82F6">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#3B82F6" />
                            </Button>
                            <!-- Emerald -->
                            <Button Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                    Command="{Binding SelectAccentColorCommand}" CommandParameter="#10B981">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#10B981" />
                            </Button>
                            <!-- Purple -->
                            <Button Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                    Command="{Binding SelectAccentColorCommand}" CommandParameter="#8B5CF6">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#8B5CF6" />
                            </Button>
                            <!-- Amber -->
                            <Button Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                    Command="{Binding SelectAccentColorCommand}" CommandParameter="#F59E0B">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#F59E0B" />
                            </Button>
                            <!-- Crimson -->
                            <Button Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                    Command="{Binding SelectAccentColorCommand}" CommandParameter="#EF4444">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#EF4444" />
                            </Button>
                            <!-- Cyan -->
                            <Button Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0"
                                    Command="{Binding SelectAccentColorCommand}" CommandParameter="#06B6D4">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#06B6D4" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Safety & Cleanup Section -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Safety Engine &amp; Cleanup Controls" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Scan Mode -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Scanning Heuristic Mode" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Conservative prioritizes absolute safety. Deep checks deeper subfolders." FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource FluentComboBox}" Width="160" 
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding ScanMode, Mode=TwoWay}">
                            <ComboBoxItem Tag="Conservative" Content="🛡️ Güvenli Mod" />
                            <ComboBoxItem Tag="Deep" Content="🔍 Derin Tarama" />
                        </ComboBox>
                    </Grid>

                    <!-- Recycle Bin First -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Move Files to Windows Recycle Bin" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Allows immediate undo through standard Windows Shell Recycle Bin" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource FluentCheckBox}" IsChecked="{Binding SendToRecycleBin}" />
                    </Grid>

                    <!-- Quarantine Backups -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Create Reversible Quarantine Backups" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Backs up residual files and exports registry .reg snapshots before any deletion" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource FluentCheckBox}" IsChecked="{Binding CreateQuarantineBackup}" />
                    </Grid>

                    <!-- Excluded Directories Manager -->
                    <TextBlock Text="Custom Excluded Paths" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,4" />
                    <TextBlock Text="Paths listed here are strictly prohibited from being scanned or removed by the cleanup engine:" 
                               FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" Text="{Binding NewExcludedPath, UpdateSourceTrigger=PropertyChanged}" Tag="Enter directory path to protect..." />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding AddExcludedPathCommand}" Content="+ Add Exclusion" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ExcludedPaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="22" FontSize="10" Padding="6,0,6,0"
                                                Command="{Binding DataContext.RemoveExcludedPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Content="Remove ✕" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- Diagnostics & Storage Section -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="Application Information &amp; Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="AppTrace Version:" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding AppVersion}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Local Audit Database:" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding DatabaseSizeFormatted}" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Platform Architecture:" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock HorizontalAlignment="Right" Text="Windows 11 (x64) • .NET 9 Desktop Runtime" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetSettingsCommand}" Content="↺ Reset All Settings to Defaults" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
