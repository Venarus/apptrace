<UserControl x:Class="AppTrace.UI.Views.LeftoverScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LeftoverScannerViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Intelligent Leftover Scanner" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding CancelScanCommand}" 
                        IsEnabled="{Binding IsScanning}"
                        Content="Cancel Scan" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" 
                        Command="{Binding StartScanCommand}" 
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InvBoolToVis}}"
                        Content="🔍 Start Deep Scan" />
            </StackPanel>
        </Grid>

        <!-- Target App Banner (if specific app targeted) -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" 
                Visibility="{Binding TargetApp, Converter={StaticResource NullOrEmptyToVis}}"
                Background="#203B82F6" BorderBrush="{StaticResource AccentBrush}"
                Margin="0,0,0,16" Padding="14,10,14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Targeting Residuals For:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding TargetApp.DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding TargetApp.Publisher, StringFormat='by {0}'}" Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="28" FontSize="11" 
                        Command="{Binding ClearTargetAppCommand}" Content="Switch to All Orphans ✕" />
            </Grid>
        </Border>

        <!-- Stats & Confidence Filter Strip -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Stat 1: Total Removable -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Remnants" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding FilteredCandidates.Count}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Stat 2: Recoverable Space -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Recoverable Space" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding TotalRemovableSpace}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>

                <!-- Filter Pills -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,0,0,0">
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="All Remnants" 
                                 Click="OnConfidenceFilterClicked" Tag="All" Margin="0,0,4,0" IsChecked="True" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="High Confidence" 
                                 Click="OnConfidenceFilterClicked" Tag="High" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="Possible Matches" 
                                 Click="OnConfidenceFilterClicked" Tag="Possible" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="Uncertain" 
                                 Click="OnConfidenceFilterClicked" Tag="Uncertain" />
                </StackPanel>

                <!-- Selection Quick Actions -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Height="28" FontSize="11" Command="{Binding SelectHighConfidenceCommand}" Content="Select Safe Only" Margin="0,0,6,0" />
                    <Button Style="{StaticResource SecondaryButton}" Height="28" FontSize="11" Command="{Binding SelectAllCommand}" Content="Select All" Margin="0,0,6,0" />
                    <Button Style="{StaticResource SecondaryButton}" Height="28" FontSize="11" Command="{Binding DeselectAllCommand}" Content="Deselect All" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Candidates DataGrid -->
        <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="4">
            <DataGrid Style="{StaticResource FluentDataGrid}"
                      ItemsSource="{Binding FilteredCandidates}">
                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource FluentCheckBox}" 
                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.ToggleItemSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type Icon & Path -->
                    <DataGridTemplateColumn Header="Residual Path" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AssociatedAppName, StringFormat='Associated with: {0}'}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Size -->
                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100" />

                    <!-- Confidence Badge -->
                    <DataGridTemplateColumn Header="Confidence" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left"
                                        Background="{Binding Confidence, Converter={StaticResource ConfidenceToColor}}" Opacity="0.9">
                                    <TextBlock Text="{Binding ConfidenceBadge}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Detection Reason -->
                    <DataGridTextColumn Header="Detection Reason" Binding="{Binding DetectionReason}" Width="2*" />

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Explore" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Height="24" FontSize="11" Padding="6,0,6,0"
                                        Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Content="Open" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Review & Cleanup Confirmation Bar -->
        <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource GlassCard}" Padding="16,12,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Options -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource FluentCheckBox}" IsChecked="{Binding SendToRecycleBin}" Content="♻️ Move to Windows Recycle Bin" Margin="0,0,20,0" />
                    <CheckBox Style="{StaticResource FluentCheckBox}" IsChecked="{Binding CreateQuarantineBackup}" Content="🛡️ Create Quarantine Backup first" Margin="0,0,20,0" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat='Selected: {0} items'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SelectedSizeFormatted, StringFormat='({0})'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Action Button -->
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                        Command="{Binding StartCleanupWorkflowCommand}" 
                        Content="Review &amp; Clean Selected Items →" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
