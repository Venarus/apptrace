<UserControl x:Class="AppTrace.UI.Views.InstalledAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:InstalledAppsViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Loc[Apps_Title]}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Refresh Action -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding RefreshAppsCommand}" 
                        Content="{Binding Loc[Overview_Refresh]}" />
            </StackPanel>
        </Grid>

        <!-- Search & Filter Controls Bar -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" 
                         Style="{StaticResource FluentTextBox}" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="{Binding Loc[Apps_SearchPlaceholder]}" />

                <!-- Filter Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="{Binding Loc[Apps_Filter_All]}" 
                                 IsChecked="{Binding SelectedFilter, ConverterParameter='All', Mode=OneWay}"
                                 Command="{Binding DataContext.RefreshAppsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Click="OnFilterClicked" Tag="All" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="{Binding Loc[Apps_Filter_Desktop]}" 
                                 Click="OnFilterClicked" Tag="Desktop" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="{Binding Loc[Apps_Filter_Store]}" 
                                 Click="OnFilterClicked" Tag="Store" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="{Binding Loc[Apps_Filter_Large]}" 
                                 Click="OnFilterClicked" Tag="Large (>1GB)" Margin="0,0,4,0" />
                    <RadioButton Style="{StaticResource FilterTabButton}" Content="{Binding Loc[Apps_Filter_Recent]}" 
                                 Click="OnFilterClicked" Tag="Recent" />
                </StackPanel>

                <!-- Category Dropdown -->
                <ComboBox Grid.Column="4" Style="{StaticResource FluentComboBox}" 
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedCategory, Mode=TwoWay}">
                    <ComboBoxItem Tag="All" Content="📂 Tüm Kategoriler" IsSelected="True" />
                    <ComboBoxItem Tag="Development" Content="💻 Yazılım &amp; Kodlama" />
                    <ComboBoxItem Tag="Productivity" Content="📑 Üretkenlik &amp; Ofis" />
                    <ComboBoxItem Tag="Internet" Content="🌐 İnternet &amp; Tarayıcı" />
                    <ComboBoxItem Tag="Multimedia" Content="🎬 Medya &amp; Tasarım" />
                    <ComboBoxItem Tag="Utilities" Content="🛠️ Araçlar &amp; Yardımcılar" />
                    <ComboBoxItem Tag="Games" Content="🎮 Oyunlar" />
                    <ComboBoxItem Tag="System" Content="⚙️ Sistem &amp; Donanım" />
                    <ComboBoxItem Tag="Other" Content="📦 Diğer" />
                </ComboBox>

                <!-- Sort Dropdown -->
                <ComboBox Grid.Column="6" Style="{StaticResource FluentComboBox}" 
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SortBy, Mode=TwoWay}">
                    <ComboBoxItem Tag="Name" Content="🔤 İsim (A - Z)" IsSelected="True" />
                    <ComboBoxItem Tag="SizeDesc" Content="📉 Boyut (En Büyük)" />
                    <ComboBoxItem Tag="SizeAsc" Content="📈 Boyut (En Küçük)" />
                    <ComboBoxItem Tag="DateDesc" Content="📅 Tarih (En Yeni)" />
                    <ComboBoxItem Tag="Publisher" Content="🏢 Yayıncı Adı" />
                </ComboBox>

            </Grid>
        </Border>

        <!-- Main Apps List (DataGrid) -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="4">
            <DataGrid Style="{StaticResource FluentDataGrid}"
                      ItemsSource="{Binding FilteredApps}"
                      SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                      MouseDoubleClick="OnDataGridDoubleClick">
                <DataGrid.Columns>
                    <!-- App Name & Icon -->
                    <DataGridTemplateColumn Header="Application Name" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border Width="28" Height="28" Background="#20FFFFFF" CornerRadius="6" Margin="0,0,10,0">
                                        <Grid>
                                            <Image Source="{Binding IconSource}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconSource, Converter={StaticResource NullOrEmptyToVis}}" />
                                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IconSource, Converter={StaticResource NullOrEmptyToVis}, ConverterParameter='Inverse'}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding DisplayVersion}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Publisher -->
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.4*" />

                    <!-- Install Date -->
                    <DataGridTextColumn Header="Install Date" Binding="{Binding FormattedInstallDate}" Width="*" />

                    <!-- Size & Confidence Badge -->
                    <DataGridTemplateColumn Header="Estimated Size" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormattedSize}" FontWeight="Medium" FontSize="12" Margin="0,0,6,0" />
                                    <!-- Size Confidence Pill -->
                                    <Border CornerRadius="4" Padding="4,1,4,1" 
                                            Background="{Binding SizeConfidence, Converter={StaticResource SizeConfidenceToColor}}" Opacity="0.85">
                                        <TextBlock Text="{Binding SizeConfidence}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Source -->
                    <DataGridTemplateColumn Header="Source" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InstallSource}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Action Trigger -->
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Height="26" FontSize="11" Padding="8,0,8,0"
                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Inspect →" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Selected Application Quick Actions Bottom Bar -->
        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource GlassCard}" 
                Visibility="{Binding SelectedApp, Converter={StaticResource NullOrEmptyToVis}}" Padding="16,12,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#20FFFFFF" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding SelectedApp.IconSource}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding SelectedApp.IconSource, Converter={StaticResource NullOrEmptyToVis}}" />
                            <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedApp.IconSource, Converter={StaticResource NullOrEmptyToVis}, ConverterParameter='Inverse'}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Selected:" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedApp.DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding SelectedApp.FormattedSize}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding SelectedApp.InstallLocation}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" MaxWidth="350" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding LaunchAppCommand}" Content="{Binding Loc[Apps_Launch]}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Content="{Binding Loc[Apps_OpenFolder]}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ScanLeftoversCommand}" Content="{Binding Loc[Apps_ScanLeftovers]}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ViewDetailsCommand}" Content="{Binding Loc[Apps_Details]}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource DangerButton}" Command="{Binding StartUninstallCommand}" Content="{Binding Loc[Apps_Uninstall]}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
