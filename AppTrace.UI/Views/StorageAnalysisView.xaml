<UserControl x:Class="AppTrace.UI.Views.StorageAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StorageAnalysisViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Storage Analysis" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Detailed disk usage visualization and application footprint breakdown" 
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                        Command="{Binding NavigateToScannerCommand}" 
                        Content="🧹 Scan Removable Leftovers" VerticalAlignment="Center" />
            </Grid>

            <!-- Drive Capacity Banner Card -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="System Drive (C:\) Consumption" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                            <Border Background="#203B82F6" CornerRadius="4" Padding="6,2,6,2">
                                <TextBlock Text="NTFS Primary" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding DriveUsedFormatted, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="used / " />
                            <Run Text="{Binding DriveFreeFormatted, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            <Run Text="free (" />
                            <Run Text="{Binding DriveCapacityFormatted, Mode=OneWay}" />
                            <Run Text="total)" />
                        </TextBlock>
                    </Grid>

                    <!-- Large Gradient Progress Bar -->
                    <ProgressBar Height="12" Value="{Binding DriveUsedPercentage}" Maximum="100" 
                                 Foreground="{StaticResource AccentBrush}" Background="#20FFFFFF" BorderThickness="0" Margin="0,0,0,8" />

                    <Grid>
                        <TextBlock Text="{Binding DriveUsedPercentage, StringFormat='{}{0:0.#}% Disk Space Occupied'}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding RemovableSpaceFormatted, StringFormat='Removable Remnants: ~{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Two Columns: Category Breakdown & Size Ranges -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Category Breakdown Card -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Application Categories" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding AppCount, StringFormat='({0} apps)'}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0:0.#}%'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Value="{Binding Percentage}" Maximum="100" 
                                                     Foreground="{StaticResource AccentBrush}" Background="#15FFFFFF" BorderThickness="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Size Ranges Card -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Size Distribution" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <ItemsControl ItemsSource="{Binding SizeRanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                            <Border Grid.Column="1" Background="#203B82F6" CornerRadius="6" Padding="8,2,8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count, StringFormat='{}{0} apps'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding TotalSizeBytes, Converter={StaticResource BoolToVis}}" 
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top 10 Largest Applications Leaderboard -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="Top 10 Largest Applications" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding LargestApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" Background="#20FFFFFF" CornerRadius="6" Margin="0,0,12,0">
                                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Size -->
                                        <Border Grid.Column="2" Background="#203B82F6" CornerRadius="6" Padding="10,4,10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                        </Border>

                                        <!-- Details Button -->
                                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Height="28" FontSize="11"
                                                Command="{Binding DataContext.SelectAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Content="Inspect →" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
