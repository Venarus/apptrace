<UserControl x:Class="AppTrace.UI.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StartupManagerViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Startup Application Manager" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Inspect and safely manage applications configured to boot with Windows" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" 
                    Command="{Binding RefreshEntriesCommand}" Content="↻ Refresh Startup" />
        </Grid>

        <!-- Stats & Search Strip -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="Search startup programs..." />

                <!-- Total -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Total Registered" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding TotalEntriesCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Enabled -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="Active on Boot" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding EnabledCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>

                <!-- Disabled -->
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Text="Disabled" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding DisabledCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="7" Background="#15FFFFFF" CornerRadius="8" Padding="12,6,12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ Entries are disabled via Windows StartupApproved registry; never deleted." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Startup DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="4">
            <DataGrid Style="{StaticResource FluentDataGrid}" ItemsSource="{Binding FilteredEntries}">
                <DataGrid.Columns>
                    <!-- Status Indicator & Name -->
                    <DataGridTemplateColumn Header="Startup Program" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0" 
                                            Background="{Binding IsEnabled, Converter={StaticResource StartupStateToColor}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Source -->
                    <DataGridTemplateColumn Header="Source" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Executable Path -->
                    <DataGridTemplateColumn Header="Executable Path" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExecutablePath}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Verification Badge -->
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left"
                                        Background="{Binding IsEnabled, Converter={StaticResource StartupStateToColor}}" Opacity="0.85">
                                    <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToVis}, ConverterParameter='Enabled|Disabled'}" 
                                               FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Toggle Enable/Disable Button -->
                                    <Button Style="{StaticResource SecondaryButton}" Height="26" FontSize="11" Padding="8,0,8,0" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ToggleEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding IsEnabled, Converter={StaticResource BoolToVis}, ConverterParameter='Disable|Enable'}" />

                                    <!-- Locate Executable -->
                                    <Button Style="{StaticResource SecondaryButton}" Height="26" FontSize="11" Padding="8,0,8,0"
                                            Command="{Binding DataContext.OpenExecutableLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Locate 📁" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
