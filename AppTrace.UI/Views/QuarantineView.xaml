<UserControl x:Class="AppTrace.UI.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:QuarantineViewModel}"
             FontFamily="{StaticResource FluentFont}">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quarantine &amp; Rollback Vault" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Isolated backups created before removals. Any item can be safely restored to its exact original location." 
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" 
                    Command="{Binding RefreshItemsCommand}" Content="↻ Refresh Vault" />
        </Grid>

        <!-- Stats Bar -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quarantined Items" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding TotalItemsCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Vault Storage Footprint" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding TotalQuarantinedSize}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <Border Grid.Column="3" Background="#15FFFFFF" CornerRadius="8" Padding="12,6,12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ Restoring an item re-verifies file signatures and target folder write permissions." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Quarantined Items List -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="4">
            <DataGrid Style="{StaticResource FluentDataGrid}" ItemsSource="{Binding QuarantineItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <DataGrid.Columns>
                    <!-- Type Icon & Related App -->
                    <DataGridTemplateColumn Header="Application / Item" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border Width="28" Height="28" Background="#203B82F6" CornerRadius="6" Margin="0,0,10,0">
                                        <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RelatedAppName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ItemType, StringFormat='Type: {0}'}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Original Path -->
                    <DataGridTemplateColumn Header="Original Location" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OriginalPath}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Size -->
                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="90" />

                    <!-- Date -->
                    <DataGridTextColumn Header="Quarantine Date" Binding="{Binding OperationDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Height="26" FontSize="11" Padding="10,0,10,0" Margin="0,0,6,0"
                                            Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="↺ Restore" />

                                    <Button Style="{StaticResource DangerButton}" Height="26" FontSize="11" Padding="10,0,10,0"
                                            Command="{Binding DataContext.PermanentlyDeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Delete" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
