<Window x:Class="AppTrace.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppTrace.UI.ViewModels"
        xmlns:views="clr-namespace:AppTrace.UI.Views"
        xmlns:dialogs="clr-namespace:AppTrace.UI.Dialogs"
        mc:Ignorable="d"
        Title="AppTrace — Smart Application Manager" 
        Icon="Assets/app.ico"
        Height="820" Width="1280"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource FluentFont}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstalledAppsViewModel}">
            <views:InstalledAppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppDetailsViewModel}">
            <views:AppDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeftoverScannerViewModel}">
            <views:LeftoverScannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupManagerViewModel}">
            <views:StartupManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageAnalysisViewModel}">
            <views:StorageAnalysisView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityHistoryViewModel}">
            <views:ActivityHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Two Column Main Layout: Sidebar & Content View -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Glass Panel -->
        <Border Grid.Column="0" Background="#12FFFFFF" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,20,12,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Grid Grid.Row="0" Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Brand Icon -->
                    <Border Grid.Column="0" Width="40" Height="40" Background="{StaticResource AccentBrush}" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                    </Border>
                    <!-- App Title -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AppTrace" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#203B82F6" CornerRadius="4" Padding="4,1,4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Smart Application Manager" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Navigation List -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="DASHBOARD &amp; DISCOVERY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="16,0,0,8" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_Overview]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='Overview', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Overview" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_InstalledApps]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='InstalledApps', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="InstalledApps" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_LeftoverScanner]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='LeftoverScanner', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="LeftoverScanner" />

                    <TextBlock Text="SYSTEM MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="16,18,0,8" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_StartupManager]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='StartupManager', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="StartupManager" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_StorageAnalysis]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='StorageAnalysis', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="StorageAnalysis" />

                    <TextBlock Text="RECOVERY &amp; AUDIT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="16,18,0,8" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_Quarantine]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='Quarantine', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Quarantine" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_ActivityHistory]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='ActivityHistory', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="ActivityHistory" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{Binding Loc[Nav_Settings]}" 
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter='Settings', Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="8" Padding="12,10,12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding GlobalStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Protected Mode Active" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="🔒" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Main View Host Area -->
        <Grid Grid.Column="1">
            <!-- View Content Switcher -->
            <ContentControl x:Name="ViewHost" Content="{Binding CurrentViewModel}" />

            <!-- Global Progress Bar (Top) -->
            <ProgressBar Height="3" IsIndeterminate="{Binding IsGlobalLoading}" 
                         Visibility="{Binding IsGlobalLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="{StaticResource AccentBrush}" Background="Transparent" 
                         BorderThickness="0" VerticalAlignment="Top" />

            <!-- Sliding Toast Notification (Top Right) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,20,24,0" Width="380"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource GlassCard}" Background="#E61A2230" BorderBrush="{StaticResource AccentBrush}" Padding="16,12,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔔" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="22" Width="22" Padding="0" 
                            Command="{Binding DismissToastCommand}" Content="✕" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- Modal Overlays -->
            <!-- 1. Uninstall Dialog -->
            <dialogs:UninstallConfirmDialog Visibility="{Binding IsUninstallDialogOpen, Converter={StaticResource BoolToVis}}" />

            <!-- 2. Cleanup Confirmation Dialog -->
            <dialogs:CleanupConfirmDialog Visibility="{Binding IsCleanupDialogOpen, Converter={StaticResource BoolToVis}}" />

            <!-- 3. Message Confirmation Dialog -->
            <dialogs:MessageConfirmDialog Visibility="{Binding IsConfirmDialogOpen, Converter={StaticResource BoolToVis}}" />

        </Grid>

    </Grid>
</Window>
